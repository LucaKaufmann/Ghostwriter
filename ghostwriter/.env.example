# Ghostwriter first-run configuration
# Copy this file to .env and set only the provider block you want to use.
# Everything else falls back to built-in defaults.

# Optional but recommended if you use scheduled digests.
TIMEZONE=UTC

# Default provider: OpenAI
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano

# Optional but recommended if you want web sessions to survive restarts.
# JWT_SECRET=

# Gemini alternative:
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash-lite

# Ollama alternative:
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://ollama:11434
# OLLAMA_MODEL=llama3.2
