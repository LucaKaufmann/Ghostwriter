# Ghostwriter Environment Configuration
# Copy this file to .env and configure for your deployment

# =============================================================================
# GENERAL SETTINGS
# =============================================================================

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# IANA timezone identifier (e.g., America/New_York, Europe/London)
TIMEZONE=UTC

# Legacy API authentication key. Prefer web UI accounts plus per-device API tokens
# for new deployments. Leave empty to rely on the account-based setup flow.
GHOSTWRITER_API_KEY=

# Secret key for JWT tokens (recommended for persistent sessions)
JWT_SECRET=

# =============================================================================
# AI PROVIDER CONFIGURATION
# =============================================================================

# Provider selection: openai, gemini, ollama
AI_PROVIDER=openai

# --- OpenAI (default) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5-nano

# --- Google Gemini ---
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.0-flash-lite

# --- Ollama (Local, requires separate Ollama server) ---
# To use Ollama, set AI_PROVIDER=ollama and start with: docker compose --profile with-ollama up -d
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2

# --- AI Behavior ---
# Timeout per article summarization (seconds)
AI_TIMEOUT_SECONDS=60
# Retries before falling back to raw text
AI_MAX_RETRIES=2
# Timeout for AI cover image generation (seconds)
COVER_GENERATION_TIMEOUT_SECONDS=60

# --- Transcription (whisper.cpp / OpenAI Whisper API) ---
# whisper.cpp binary path
WHISPER_CPP_BINARY=/usr/local/bin/whisper-cli
# whisper.cpp models directory
WHISPER_MODELS_DIR=/app/data/models/whisper
# Local transcription timeout (seconds)
WHISPER_TRANSCRIPTION_TIMEOUT_SECONDS=300
# OpenAI Whisper API timeout (seconds)
OPENAI_WHISPER_TIMEOUT_SECONDS=120

# =============================================================================
# SCHEDULING
# =============================================================================

# Master switch for scheduled runs
SCHEDULE_ENABLED=true

# Schedule times in 24h format (HH:MM). Leave empty to disable a period.
SCHEDULE_MORNING=07:00
SCHEDULE_NOON=
SCHEDULE_EVENING=18:00

# =============================================================================
# RATE LIMITING & CAPS
# =============================================================================

# Delay between feed fetches (milliseconds)
FETCH_DELAY_MS=500

# Timeout for fetching a single feed (seconds)
FETCH_TIMEOUT_SECONDS=30

# Maximum articles to fetch per feed per run
MAX_ARTICLES_PER_FEED=10

# Maximum total articles per digest
MAX_ARTICLES_PER_DIGEST=50

# Parallel feed fetches
MAX_CONCURRENT_FETCHES=3

# Allow private/localhost outbound URLs (SSRF protection). Keep false for public deployments.
ALLOW_PRIVATE_HOSTS=false

# =============================================================================
# SECURITY & NETWORKING
# =============================================================================

# CORS allowlist (comma-separated). Empty disables CORS entirely.
CORS_ALLOW_ORIGINS=

# Allow credentials for CORS requests (cookies/Authorization headers)
CORS_ALLOW_CREDENTIALS=false

# Enable OpenAPI docs endpoints (/docs, /redoc, /openapi.json)
ENABLE_API_DOCS=false

# Trusted proxy IPs/CIDRs for X-Forwarded-* headers (comma-separated)
TRUSTED_PROXY_HOSTS=

# Public URL used in podcast RSS feed links/enclosures (must be reachable by podcast apps)
PODCAST_PUBLIC_BASE_URL=

# Auth rate limiting
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# =============================================================================
# RETENTION & CLEANUP
# =============================================================================

# Days to keep old EPUB files
DIGEST_RETENTION_DAYS=7

# Days to track seen articles for deduplication
SEEN_ARTICLE_RETENTION_DAYS=30

# =============================================================================
# NOTIFICATIONS (Optional)
# =============================================================================

# Webhook URL for notifications (e.g., ntfy, Pushover, Home Assistant)
WEBHOOK_URL=

# Notify on successful digest completion
WEBHOOK_ON_COMPLETE=true

# Notify on digest failure
WEBHOOK_ON_FAILURE=true
